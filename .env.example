# Copy to .env.local and fill in. Never commit the real .env.local (already gitignored).

# Postgres connection string (Neon or Supabase)
DATABASE_URL=

# Shopify app credentials (Phase 2)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Same value as SHOPIFY_API_KEY, but exposed to the browser (App Bridge needs it client-side; it's a public client ID, not secret)
NEXT_PUBLIC_SHOPIFY_API_KEY=
# Base URL of this deployment, e.g. https://accounts4u.vercel.app (used to build the webhook callbackUrl)
SHOPIFY_APP_URL=
# Optional override; defaults to read_orders,read_products,read_shopify_payments_payouts
SHOPIFY_SCOPES=

# Sent by Vercel Cron as `Authorization: Bearer $CRON_SECRET` to authenticate /api/shopify/sync
CRON_SECRET=

# Signs the app's own session cookie (lib/shopify/app-session.ts), minted
# only after Shopify verifies an id_token via Token Exchange -- this is
# what every page/action uses to know which store a request belongs to,
# instead of trusting the `shop` query parameter on its own. Generate with
# `openssl rand -hex 32`. Rotating it logs every merchant out (they just
# reopen the app from Shopify admin to get a new session).
SESSION_SECRET=

# Stripe (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price ID for the £9-15/month plan (PLAN.md) -- create the product/price in the Stripe dashboard first
STRIPE_PRICE_ID=

# Error monitoring (Phase 5, Sentry free tier). Safe to leave unset -- the
# SDK no-ops without a DSN, it just won't report anything.
SENTRY_DSN=
# Optional: only needed to enable source map upload at build time.
SENTRY_ORG=
SENTRY_PROJECT=

# Shared secret for the /admin/health sync-health page, e.g. `openssl rand -hex 32`.
# Visit /admin/health?token=<this value>. Leave unset to keep the page 404ing.
ADMIN_SECRET=
