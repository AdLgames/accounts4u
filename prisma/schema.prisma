// Phase 1/2 skeleton. Models are added as each phase needs them.
// Requires DATABASE_URL (Neon or Supabase Postgres connection string) at
// migrate/generate time — see README.md for setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id          String   @id @default(cuid())
  shopDomain  String   @unique
  accessToken String
  scope       String
  installedAt DateTime @default(now())

  // Shopify requires expiring offline tokens now (mandatory for all public
  // apps by 2027-01-01) -- a 60-minute access token plus a 90-day refresh
  // token, both returned from the same token-exchange call. Nullable since
  // rows created before this field existed won't have them; a proper
  // refresh-before-use flow is a follow-up, not built yet.
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  // Null until registerWebhooks actually succeeds. Lets exchangeSessionToken
  // retry registration on a later connect if the first attempt failed (e.g.
  // protected customer data access wasn't granted yet), without redoing it
  // -- and paying its API calls -- on every single page load once it works.
  webhooksRegisteredAt DateTime?

  // Phase 5 billing (PLAN.md): 14-day trial from install, then read-only
  // until subscribed -- don't delete their data, per PLAN.md, since that's
  // the reason they come back. subscriptionStatus mirrors Stripe's own
  // status strings ("trialing" | "active" | "past_due" | "canceled" | ...)
  // rather than a separate parallel state machine; it only changes once a
  // Stripe webhook actually fires (see lib/billing/, Stripe account/keys
  // not wired up in this environment yet).
  trialEndsAt          DateTime?
  subscriptionStatus   String    @default("trialing")
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // Set by the cron sync sweep (app/api/shopify/sync) on every run, success
  // or failure -- backs the admin health page (PLAN.md Phase 5). Null until
  // the first sweep runs for a store.
  lastSyncAt    DateTime?
  lastSyncError String?

  // Watermark for syncBalanceTransactions (lib/shopify/sync.ts) -- the
  // shopify_payments/balance/transactions.json endpoint has no date-range
  // filter (confirmed: payout_id, since_id, test are the only query params),
  // so incremental sync uses the highest transaction id seen so far instead
  // of a date window. Null means "no watermark yet", i.e. page the store's
  // entire lifetime history on the next sync.
  lastBalanceTransactionId String?

  rawOrders       RawOrder[]
  rawTransactions RawTransaction[]
  rawPayouts      RawPayout[]
  settings        StoreSettings?
  productCosts    ProductCost[]
  bills           Bill[]

  @@map("stores")
}

// Raw data is immutable (see CLAUDE.md): each sync (backfill, webhook, or
// sweep) appends a new row rather than updating an existing one, so
// raw_orders/raw_transactions/raw_payouts are an append-only log of exactly
// what Shopify sent. Derived/current-state tables are built separately in
// Phase 3, on top of this log.

model RawOrder {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  shopifyId  String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([storeId, shopifyId])
  @@map("raw_orders")
}

model RawTransaction {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  shopifyId  String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([storeId, shopifyId])
  @@map("raw_transactions")
}

model RawPayout {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  shopifyId  String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([storeId, shopifyId])
  @@map("raw_payouts")
}

// Our own app data (not synced from Shopify), so ordinary update-in-place
// semantics apply here -- unlike the raw_* tables above.

model StoreSettings {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id])

  /** Whole percent, e.g. 25 means set aside 25% of net sales. An estimate, not tax advice -- see PLAN.md. */
  taxSetAsidePercent Int @default(25)
  /** Minor units. Superseded by the itemized Bill model -- no longer read by any code, dropped in a follow-up migration once that's confirmed live (see prisma/migrations/20260808210000_*). */
  monthlyAdSpend Int @default(0)
  /** Minor units. Superseded by the itemized Bill model -- see monthlyAdSpend comment above. */
  recurringExpenses Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

model ProductCost {
  id              String @id @default(cuid())
  storeId         String
  store           Store  @relation(fields: [storeId], references: [id])
  shopifyProductId String
  /** Minor units, cost per single unit of this product. */
  costPerUnit Int

  updatedAt DateTime @updatedAt

  @@unique([storeId, shopifyProductId])
  @@map("product_costs")
}

// Itemized bills/expenses (Phase 6 finance dashboard rework): replaces the
// old flat StoreSettings.monthlyAdSpend/recurringExpenses numbers. Entered
// manually or via CSV import (lib/bills/csv.ts) -- Shopify's own Bill Pay
// feature has no public API to read from, confirmed via research.
model Bill {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  vendor String
  /** Validated against BILL_CATEGORIES (lib/bills/types.ts) at the app layer, not a DB enum -- same pattern as Store.subscriptionStatus. */
  category String
  /** Minor units. Always positive -- a bill is a cost, never modeled as negative income. */
  amount Int

  /** Accrual date -- which P&L period this expense counts in (lib/dashboard/profit-and-loss.ts). */
  incurredOn DateTime @db.Date
  /** "unpaid" | "paid". */
  status String @default("unpaid")
  /** Cash date -- which Cashflow period this counts in (lib/dashboard/cashflow.ts). Required iff status = "paid", enforced in lib/bills/db.ts. */
  paidOn DateTime? @db.Date

  notes String?
  /** Reserved for a future invoice-upload feature (storage provider not yet decided) -- unused by any code today. */
  receiptUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, incurredOn])
  @@index([storeId, paidOn])
  @@map("bills")
}

// Audit trail for Shopify's mandatory GDPR compliance webhooks (see
// lib/shopify/compliance.ts). Deliberately not linked to Store via a
// foreign key -- a shop/redact request deletes the Store row, but the
// record that we received and handled these requests needs to survive
// that deletion for compliance purposes.
model ComplianceRequest {
  id         String   @id @default(cuid())
  shopDomain String
  /** "customers/data_request" | "customers/redact" | "shop/redact" */
  type    String
  payload Json
  handledAt DateTime @default(now())

  @@index([shopDomain])
  @@map("compliance_requests")
}
