// Phase 1/2 skeleton. Models are added as each phase needs them.
// Requires DATABASE_URL (Neon or Supabase Postgres connection string) at
// migrate/generate time — see README.md for setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id          String   @id @default(cuid())
  shopDomain  String   @unique
  accessToken String
  scope       String
  installedAt DateTime @default(now())

  // Shopify requires expiring offline tokens now (mandatory for all public
  // apps by 2027-01-01) -- a 60-minute access token plus a 90-day refresh
  // token, both returned from the same token-exchange call. Nullable since
  // rows created before this field existed won't have them; a proper
  // refresh-before-use flow is a follow-up, not built yet.
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  rawOrders       RawOrder[]
  rawTransactions RawTransaction[]
  rawPayouts      RawPayout[]
  settings        StoreSettings?
  productCosts    ProductCost[]

  @@map("stores")
}

// Raw data is immutable (see CLAUDE.md): each sync (backfill, webhook, or
// sweep) appends a new row rather than updating an existing one, so
// raw_orders/raw_transactions/raw_payouts are an append-only log of exactly
// what Shopify sent. Derived/current-state tables are built separately in
// Phase 3, on top of this log.

model RawOrder {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  shopifyId  String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([storeId, shopifyId])
  @@map("raw_orders")
}

model RawTransaction {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  shopifyId  String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([storeId, shopifyId])
  @@map("raw_transactions")
}

model RawPayout {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  shopifyId  String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([storeId, shopifyId])
  @@map("raw_payouts")
}

// Our own app data (not synced from Shopify), so ordinary update-in-place
// semantics apply here -- unlike the raw_* tables above.

model StoreSettings {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id])

  /** Whole percent, e.g. 25 means set aside 25% of net sales. An estimate, not tax advice -- see PLAN.md. */
  taxSetAsidePercent Int @default(25)
  /** Minor units. Manual monthly entry v1 (ad platform APIs later, per PLAN.md). */
  monthlyAdSpend Int @default(0)
  /** Minor units. Rent, software subscriptions, etc. */
  recurringExpenses Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

model ProductCost {
  id              String @id @default(cuid())
  storeId         String
  store           Store  @relation(fields: [storeId], references: [id])
  shopifyProductId String
  /** Minor units, cost per single unit of this product. */
  costPerUnit Int

  updatedAt DateTime @updatedAt

  @@unique([storeId, shopifyProductId])
  @@map("product_costs")
}
